{
  "expo": {
    "name": "Re:Mind",
    "slug": "remind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remind",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jaggureddy.remind",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF9F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.jaggureddy.remind",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-share-intent",
        {
          "ios": {
            "AppGroup": "group.com.jaggureddy.remind"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
