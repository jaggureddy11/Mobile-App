{
  "expo": {
    "name": "Re:Mind",
    "slug": "remind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remind",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jaggureddy.remind",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF9F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.jaggureddy.remind",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#D4C4B0",
          "sounds": [
            "./assets/sounds/nudge.wav"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "ios": {
            "AppGroup": "group.com.jaggureddy.remind"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "com.jaggureddy.remind.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jaggureddy.remind"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "880affa9-9cfd-4294-b071-047f7a676651"
      }
    }
  }
}
